#!/usr/bin/env bash
set -euo pipefail

root="$(git rev-parse --show-toplevel)"
delegate="${KDV_PRE_PUSH_DELEGATE:-$(git config --get kdv.pre-push-delegate || true)}"

if [[ -n "$delegate" ]]; then
  if [[ ! -x "$delegate" ]]; then
    printf 'KDV pre-push: configured delegate is not executable: %s\n' "$delegate" >&2
    exit 1
  fi
  updates="$(cat)"
  printf '%s\n' "$updates" | "$delegate" "$@"
  printf '%s\n' "$updates" | python3 "$root/scripts/release/verify-issue-governance.py"
  exit $?
fi

exec python3 "$root/scripts/release/verify-issue-governance.py"
